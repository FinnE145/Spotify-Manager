# docs/specs/host-on-fe-pro-Q.md §4.4. Copy this to /srv/stacks/symr/symr.env on
# fe-pro (mode 600, owned by finne) and fill in the real values. That file is
# never committed -- this example is.

SPOTIFY_CLIENT_ID=same-as-laptop
SPOTIFY_CLIENT_SECRET=same-as-laptop
SPOTIFY_REDIRECT_URI=https://fe-pro.tail78f5ec.ts.net/callback

SYMR_DB_PATH=/data/symr.db
SYMR_SPOTIPY_CACHE=/data/.spotipy_cache
SYMR_UPLOAD_ROOT=/data/streaming_history

SYMR_PORT=45660
# 0, always. The reloader restarts on any .py write and would kill an
# in-flight pull mid-transaction -- and there is no reloader use case on a
# service that restarts on its own.
SYMR_DEBUG=0

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# No fallback -- config.py refuses to start without this set.
SYMR_SECRET_KEY=generate-a-fresh-one-do-not-reuse-the-laptops
